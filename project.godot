; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="rhythm-godot"
config/description="ADOFAI형 원버튼 리듬게임. 타일 각도가 곧 대기 박자 수."
run/main_scene="res://scenes/SongSelect.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

AudioClock="*res://scenes/AudioClock.tscn"
GameState="*res://scripts/GameState.gd"
Records="*res://scripts/Records.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.055, 0.06, 0.08, 1)
